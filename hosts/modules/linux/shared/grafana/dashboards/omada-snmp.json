{
  "annotations": {
    "list": []
  },
  "description": "ER707-M2 SNMP health, uptime, interface traffic, errors, and scrape continuity for investigating gateway hangs.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Omada syslog troubleshooting",
      "type": "link",
      "url": "/d/omada-gateway/omada-gateway-troubleshooting?${__url_time_range}"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "A value of zero means VictoriaMetrics could not complete the SNMP scrape. During a hard gateway hang this normally drops before any recovery or reboot event appears in syslog.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "UNREACHABLE"
                },
                "1": {
                  "color": "green",
                  "text": "REACHABLE"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "up{job=\"snmp-omada-gateway\", instance=~\"$instance\"}",
          "instant": true,
          "legendFormat": "{{device}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "SNMP reachability",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Time since the gateway SNMP management subsystem last initialized. A sudden decrease indicates a gateway or SNMP-agent restart.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sysUpTime{job=\"snmp-omada-gateway\", instance=~\"$instance\"} / 100",
          "instant": true,
          "legendFormat": "Uptime",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Gateway uptime",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Interfaces that are administratively enabled but operationally down.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "count((ifAdminStatus{job=\"snmp-omada-gateway\", instance=~\"$instance\"} == 1) and (ifOperStatus{job=\"snmp-omada-gateway\", instance=~\"$instance\"} != 1)) or vector(0)",
          "instant": true,
          "legendFormat": "Down interfaces",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Unexpected interfaces down",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Interface errors and discarded packets observed during the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(ifInErrors{job=\"snmp-omada-gateway\", instance=~\"$instance\"}[$__range]) + increase(ifOutErrors{job=\"snmp-omada-gateway\", instance=~\"$instance\"}[$__range]) + increase(ifInDiscards{job=\"snmp-omada-gateway\", instance=~\"$instance\"}[$__range]) + increase(ifOutDiscards{job=\"snmp-omada-gateway\", instance=~\"$instance\"}[$__range])) or vector(0)",
          "instant": true,
          "legendFormat": "Errors and discards",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Errors and discards",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Average one-minute processor load across the two ER707-M2 CPU cores.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 10,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "avg(hrProcessorLoad{job=\"snmp-omada-gateway\", instance=~\"$instance\"})",
          "instant": false,
          "legendFormat": "CPU",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "CPU utilization",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Physical memory allocated according to HOST-RESOURCES-MIB. Cache and buffers are included in the gateway's reported usage.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 11,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * hrStorageUsed{job=\"snmp-omada-gateway\", instance=~\"$instance\", hrStorageDescr=\"Physical memory\"} / hrStorageSize{job=\"snmp-omada-gateway\", instance=~\"$instance\", hrStorageDescr=\"Physical memory\"}",
          "instant": false,
          "legendFormat": "Memory",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Physical memory utilization",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 5,
      "panels": [],
      "title": "Gateway health timeline",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Continuous reachability and uptime history. Look for missing scrapes followed by uptime resetting to identify a hang and reboot.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Reachable"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bool"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "up{job=\"snmp-omada-gateway\", instance=~\"$instance\"}",
          "legendFormat": "Reachable",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sysUpTime{job=\"snmp-omada-gateway\", instance=~\"$instance\"} / 100",
          "legendFormat": "Uptime",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Reachability and uptime",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "CPU and physical memory pressure before a loss of SNMP reachability or gateway restart.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 12,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "avg(hrProcessorLoad{job=\"snmp-omada-gateway\", instance=~\"$instance\"})",
          "instant": false,
          "legendFormat": "CPU",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "100 * hrStorageUsed{job=\"snmp-omada-gateway\", instance=~\"$instance\", hrStorageDescr=\"Physical memory\"} / hrStorageSize{job=\"snmp-omada-gateway\", instance=~\"$instance\", hrStorageDescr=\"Physical memory\"}",
          "instant": false,
          "legendFormat": "Memory",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "CPU and memory utilization",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Per-interface traffic rate. Select the physical WAN interface after SNMP data reveals the ER707-M2 interface names.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 25
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "rate(ifHCInOctets{job=\"snmp-omada-gateway\", instance=~\"$instance\", ifName=~\"$interface\"}[$__rate_interval]) * 8",
          "legendFormat": "{{ifName}} received",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "rate(ifHCOutOctets{job=\"snmp-omada-gateway\", instance=~\"$instance\", ifName=~\"$interface\"}[$__rate_interval]) * 8",
          "legendFormat": "{{ifName}} transmitted",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Interface traffic",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Rates of interface errors and drops. Sustained increases can indicate a physical link or congestion problem before connectivity is lost.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "pps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 25
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "rate(ifInErrors{job=\"snmp-omada-gateway\", instance=~\"$instance\", ifName=~\"$interface\"}[$__rate_interval]) + rate(ifOutErrors{job=\"snmp-omada-gateway\", instance=~\"$instance\", ifName=~\"$interface\"}[$__rate_interval])",
          "legendFormat": "{{ifName}} errors",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "rate(ifInDiscards{job=\"snmp-omada-gateway\", instance=~\"$instance\", ifName=~\"$interface\"}[$__rate_interval]) + rate(ifOutDiscards{job=\"snmp-omada-gateway\", instance=~\"$instance\", ifName=~\"$interface\"}[$__rate_interval])",
          "legendFormat": "{{ifName}} discards",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Interface errors and discards",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "SNMP request latency. Rising scrape duration can be an early indication that the gateway management plane is becoming unresponsive.",
